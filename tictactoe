
#include <iostream>
using namespace std;

// Display the game board
void displayBoard(char board[3][3])
{
    cout << "\n";
    
    for (int i = 0; i < 3; i++)
    {
        cout << " ";

        for (int j = 0; j < 3; j++)
        {
            cout << board[i][j];

            if (j < 2)
                cout << " | ";
        }

        cout << endl;

        if (i < 2)
            cout << "---|---|---" << endl;
    }

    cout << endl;
}

// Check if someone has won
bool checkWinner(char board[3][3])
{
    // Check rows and columns
    for (int i = 0; i < 3; i++)
    {
        if (board[i][0] == board[i][1] &&
            board[i][1] == board[i][2])
            return true;

        if (board[0][i] == board[1][i] &&
            board[1][i] == board[2][i])
            return true;
    }

    // Check diagonals
    if (board[0][0] == board[1][1] &&
        board[1][1] == board[2][2])
        return true;

    if (board[0][2] == board[1][1] &&
        board[1][1] == board[2][0])
        return true;

    return false;
}

int main()
{
    char board[3][3] =
    {
        {'1', '2', '3'},
        {'4', '5', '6'},
        {'7', '8', '9'}
    };

    char player = 'X';
    int choice;
    int row, col;

    for (int turn = 0; turn < 9; turn++)
    {
        displayBoard(board);

        cout << "Player " << player << ", choose a space (1-9): ";
        cin >> choice;

        // Check if the choice is valid
        if (choice < 1 || choice > 9)
        {
            cout << "Invalid choice! Try again.\n";
            turn--;
            continue;
        }

        row = (choice - 1) / 3;
        col = (choice - 1) % 3;

        // Check if space is already taken
        if (board[row][col] == 'X' || board[row][col] == 'O')
        {
            cout << "That space is already taken!\n";
            turn--;
            continue;
        }

        board[row][col] = player;

        // Check for winner
        if (checkWinner(board))
        {
            displayBoard(board);
            cout << "Player " << player << " wins!\n";
            return 0;
        }

        // Switch players
        if (player == 'X')
            player = 'O';
        else
            player = 'X';
    }

    displayBoard(board);
    cout << "It's a tie!\n";

    return 0;
}
